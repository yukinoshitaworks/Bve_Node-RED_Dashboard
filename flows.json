    {
        "id": "a64e71ba3675bc72",
        "type": "function",
        "z": "584a8e8db72522a6",
        "name": "小数点以下切り上げ",
        "func": "let speed = Number(msg.payload);\nmsg.payload = Math.ceil(speed);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 500,
