                "c3cb711e8427eb0e"
            ]
        ]
    },
    {
        "id": "2ad016cc36ef20d6",
        "type": "function",
        "z": "584a8e8db72522a6",
        "name": "小数点以下四捨五入",
        "func": "// 入力された距離（m単位）を取得\nlet distance = Number(msg.payload);\n\n// 数値でない場合はそのまま返す\nif (isNaN(distance)) {\n    msg.payload = \"Invalid value\";\n    return msg;\n}\n\n// 距離を四捨五入（整数に）\nlet rounded = Math.round(distance);\n\n// km と m に分割\nlet km = Math.floor(rounded / 1000);\nlet m  = rounded % 1000;\n\n// m を3桁ゼロ埋め（例：5m → 005m）\nlet mStr = m.toString().padStart(3, \"0\");\n\n// 出力形式「〇km○○○m」\nmsg.payload = `${km}k${mStr}m`;\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 300,
        "wires": [
            [
                "c446e715ee3643cf",
                "119806d6c47a7a3f"
            ]
        ]
    },
