    {
        "id": "15281b9ca9c9f020",
        "type": "function",
        "z": "584a8e8db72522a6",
        "name": "時刻変換",
        "func": "// 入力: msg.payload にミリ秒が入っている想定\nlet ms = Number(msg.payload);\n\n// 秒へ変換\nlet totalSec = Math.floor(ms / 1000);\n\n// 時・分・秒へ変換\nlet hours = Math.floor(totalSec / 3600);\nlet minutes = Math.floor((totalSec % 3600) / 60);\nlet seconds = totalSec % 60;\n\n// 2桁ゼロ埋め\nlet hh = (\"0\" + hours).slice(-2);\nlet mm = (\"0\" + minutes).slice(-2);\nlet ss = (\"0\" + seconds).slice(-2);\n\n// 表示用の文字列\nmsg.payload = `${hh}:${mm}:${ss}`;\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 180,
        "wires": [
            [
                "770dd2018ebd84a4",
                "11cd02d87f7ae617"
            ]
        ]
    },
